{
  "appId": "com.theroom.app",
  "appName": "TheRoom",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#00FF41",
      "sound": "glitch_alert.wav"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "899211025200-lbhhcr3wdwzr4gc4q6tqhe.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    }
  }
}
