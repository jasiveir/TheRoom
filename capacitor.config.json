{
  "appId": "com.theroom.app",
  "appName": "TheRoom",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera"]
    },
    "LocalNotifications": {
      "iconColor": "#00FF41"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "243866788757-6tak9ebm0iks7sf7i98l6lepcivkol8v.apps.googleusercontent.com",
      "clientId": "243866788757-6tak9ebm0iks7sf7i98l6lepcivkol8v.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    }
  }
}
